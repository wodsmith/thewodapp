/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "317fb84f366ea1ab038ca90000953697",
	"name": "wodsmith-start",
	"main": "src/server.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"minify": true,
	"observability": {
		"enabled": true
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	"placement": {
		"mode": "smart"
	},
	"durable_objects": {
		"bindings": [{ "name": "WORKOUT_IMPORT_AGENT", "class_name": "WorkoutImportAgent" }]
	},
	"migrations": [{ "tag": "workout-import-v1", "new_sqlite_classes": ["WorkoutImportAgent"] }],
	"images": { "binding": "WORKOUT_IMPORT_IMAGES" },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Commerce: App URL for Stripe redirects (set to production URL in production)
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"EMAIL_FROM": "team@mail.wodsmith.com",
		"EMAIL_FROM_NAME": "WODsmith",
		"EMAIL_REPLY_TO": "support@mail.wodsmith.com",
		"APP_URL": "https://wodsmith.com",
		"WORKOUT_IMPORT_GATEWAY": "wodsmith-import-prod",
		"R2_PUBLIC_URL": "https://pub-10ec4eb87e8d4c7383ead07a9dd77fa5.r2.dev",
		"POSTHOG_KEY": "phc_UCtCVOUXvpuKzF50prCLKIWWCFc61j5CPTbt99OrKsK",
		"TURNSTILE_SITE_KEY": "0x4AAAAAACF8K4v1TmFMOmtk",
		"SENTRY_DSN": "https://a55d70f610d33fa3108b7faea06accb7@o4510933498462208.ingest.us.sentry.io/4510937818005504"
	},
	/**
	 * KV Namespace Binding
	 * Used for session storage
	 */
	"kv_namespaces": [
		{
			"binding": "KV_SESSION",
			"id": "e7a18a19d2cb4afbaf02be597cbecb35"
		}
	],
	/**
	 * R2 Bucket Bindings
	 * Object storage for file uploads
	 */
	"r2_buckets": [
		{
			"binding": "WORKOUT_IMPORT_SOURCES",
			"bucket_name": "wodsmith-workout-import-sources-prod"
		},
		{
			"binding": "R2_BUCKET",
			"bucket_name": "wodsmith-wodsmith-uploads-prod"
		},
		{
			"binding": "R2_DOWNLOADS_BUCKET",
			"bucket_name": "wodsmith-wodsmith-private-downloads-prod"
		},
		{
			"bucket_name": "wodsmith-uploads-dev",
			"binding": "wodsmith_uploads_dev"
		}
	]
}
